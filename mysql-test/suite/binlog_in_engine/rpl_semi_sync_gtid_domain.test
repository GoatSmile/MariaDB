#
# Test semi-synchronous replication with --binlog-storage-engine=innodb
# using multiple GTID domain IDs. Verifies that semi-sync correctly tracks
# and acknowledges transactions from different replication domains when
# the binlog is stored inside InnoDB.
#

--source include/have_binlog_format_mixed.inc
--source include/master-slave.inc
--source include/have_innodb_binlog.inc

# Suppress expected warnings
--connection master
call mtr.add_suppression("Timeout waiting for reply of binlog");
call mtr.add_suppression("Read semi-sync reply");
call mtr.add_suppression("mysqld: Got an error reading communication packets");
call mtr.add_suppression("Semi-sync master failed on net_flush");

--connection slave
set sql_log_bin=0;
call mtr.add_suppression("Semi-sync slave .* reply");
set sql_log_bin=1;

--connection master

--echo #
--echo # Setup semi-sync on master and slave
--echo #

set @save_master_timeout= @@global.rpl_semi_sync_master_timeout;
set @save_master_enabled= @@global.rpl_semi_sync_master_enabled;
set @save_master_wait_no_slave= @@global.rpl_semi_sync_master_wait_no_slave;
set @save_gtid_domain_id= @@session.gtid_domain_id;

set global rpl_semi_sync_master_timeout= 10000;
set global rpl_semi_sync_master_enabled= 1;

--connection slave
set @save_slave_enabled= @@global.rpl_semi_sync_slave_enabled;
--source include/stop_slave.inc
set global rpl_semi_sync_slave_enabled= 1;
--source include/start_slave.inc

--connection master
# Wait for slave to register as semi-sync
let $status_var= Rpl_semi_sync_master_clients;
let $status_var_value= 1;
--source include/wait_for_status_var.inc

show status like 'Rpl_semi_sync_master_status';
show status like 'Rpl_semi_sync_master_clients';

--echo #
--echo # Test 1: Transactions in different GTID domains (group commit path)
--echo #

CREATE TABLE t1 (a INT PRIMARY KEY, b VARCHAR(100)) ENGINE=InnoDB;

let $yes_before= query_get_value(SHOW STATUS LIKE 'Rpl_semi_sync_master_yes_tx', Value, 1);

SET SESSION gtid_domain_id= 1;
INSERT INTO t1 VALUES (1, 'domain1_row1');
INSERT INTO t1 VALUES (2, 'domain1_row2');

SET SESSION gtid_domain_id= 2;
INSERT INTO t1 VALUES (3, 'domain2_row1');
INSERT INTO t1 VALUES (4, 'domain2_row2');

SET SESSION gtid_domain_id= 3;
INSERT INTO t1 VALUES (5, 'domain3_row1');

--source include/save_master_gtid.inc
--connection slave
--source include/sync_with_master_gtid.inc

--connection master
let $yes_after= query_get_value(SHOW STATUS LIKE 'Rpl_semi_sync_master_yes_tx', Value, 1);
let $yes_diff= `SELECT $yes_after - $yes_before`;
--echo Multi-domain DML semi-sync acks: $yes_diff (should be >= 5)
show status like 'Rpl_semi_sync_master_no_tx';

--echo #
--echo # Test 2: DDL in different domains (non-group-commit direct path)
--echo #

let $yes_before= query_get_value(SHOW STATUS LIKE 'Rpl_semi_sync_master_yes_tx', Value, 1);

SET SESSION gtid_domain_id= 10;
CREATE TABLE t2 (a INT) ENGINE=InnoDB;

SET SESSION gtid_domain_id= 20;
CREATE TABLE t3 (a INT) ENGINE=InnoDB;

SET SESSION gtid_domain_id= 10;
DROP TABLE t2;

SET SESSION gtid_domain_id= 20;
DROP TABLE t3;

--source include/save_master_gtid.inc
--connection slave
--source include/sync_with_master_gtid.inc

--connection master
let $yes_after= query_get_value(SHOW STATUS LIKE 'Rpl_semi_sync_master_yes_tx', Value, 1);
let $yes_diff= `SELECT $yes_after - $yes_before`;
--echo Multi-domain DDL semi-sync acks: $yes_diff (should be >= 4)

--echo #
--echo # Test 3: Interleaved transactions across many domains
--echo #

let $yes_before= query_get_value(SHOW STATUS LIKE 'Rpl_semi_sync_master_yes_tx', Value, 1);

--disable_query_log
let $i= 0;
while ($i < 30)
{
  let $domain= `SELECT $i MOD 5`;
  eval SET SESSION gtid_domain_id= $domain;
  eval INSERT INTO t1 VALUES (100 + $i, CONCAT('domain', $domain, '_load'));
  inc $i;
}
--enable_query_log

--source include/save_master_gtid.inc
--connection slave
--source include/sync_with_master_gtid.inc

--connection master
let $yes_after= query_get_value(SHOW STATUS LIKE 'Rpl_semi_sync_master_yes_tx', Value, 1);
let $yes_diff= `SELECT $yes_after - $yes_before`;
--echo Interleaved multi-domain acks: $yes_diff (should be >= 30)
show status like 'Rpl_semi_sync_master_no_tx';

--echo #
--echo # Test 4: Verify GTID position contains all domains
--echo #

--connection master
--echo # Master GTID position should contain multiple domain entries:
let $master_gtid= `SELECT @@gtid_binlog_pos`;
--echo @@gtid_binlog_pos: $master_gtid

--connection slave
--echo # Slave GTID position should match:
let $slave_gtid= `SELECT @@gtid_slave_pos`;
--echo @@gtid_slave_pos: $slave_gtid

--echo #
--echo # Test 5: Switch domains and verify semi-sync still works after reconnect
--echo #

--source include/stop_slave.inc
--source include/start_slave.inc

--connection master
let $status_var= Rpl_semi_sync_master_clients;
let $status_var_value= 1;
--source include/wait_for_status_var.inc

let $yes_before= query_get_value(SHOW STATUS LIKE 'Rpl_semi_sync_master_yes_tx', Value, 1);

SET SESSION gtid_domain_id= 100;
INSERT INTO t1 VALUES (200, 'domain100_after_reconnect');

SET SESSION gtid_domain_id= 200;
INSERT INTO t1 VALUES (201, 'domain200_after_reconnect');

--source include/save_master_gtid.inc
--connection slave
--source include/sync_with_master_gtid.inc

--connection master
let $yes_after= query_get_value(SHOW STATUS LIKE 'Rpl_semi_sync_master_yes_tx', Value, 1);
let $yes_diff= `SELECT $yes_after - $yes_before`;
--echo Post-reconnect multi-domain acks: $yes_diff (should be >= 2)
show status like 'Rpl_semi_sync_master_status';

--echo #
--echo # Test 6: Verify data integrity on slave
--echo #

--connection slave
SELECT COUNT(*) FROM t1;
--echo # Verify some rows from each domain:
SELECT a, b FROM t1 WHERE b LIKE 'domain1%' ORDER BY a;
SELECT a, b FROM t1 WHERE b LIKE 'domain2%' ORDER BY a;
SELECT a, b FROM t1 WHERE b LIKE 'domain3%' ORDER BY a;

--echo #
--echo # Cleanup
--echo #

--connection master
SET SESSION gtid_domain_id= @save_gtid_domain_id;
DROP TABLE t1;
--source include/save_master_gtid.inc
--connection slave
--source include/sync_with_master_gtid.inc

--connection slave
--source include/stop_slave.inc
set global rpl_semi_sync_slave_enabled= @save_slave_enabled;
--source include/start_slave.inc

--connection master
set global rpl_semi_sync_master_enabled= @save_master_enabled;
set global rpl_semi_sync_master_timeout= @save_master_timeout;
set global rpl_semi_sync_master_wait_no_slave= @save_master_wait_no_slave;

--source include/rpl_end.inc
