include/master-slave.inc
[connection master]
connection master;
call mtr.add_suppression("Timeout waiting for reply of binlog");
call mtr.add_suppression("Read semi-sync reply");
call mtr.add_suppression("mysqld: Got an error reading communication packets");
call mtr.add_suppression("Semi-sync master failed on net_flush");
connection slave;
set sql_log_bin=0;
call mtr.add_suppression("Semi-sync slave .* reply");
set sql_log_bin=1;
connection master;
#
# Setup semi-sync on master and slave
#
set @save_master_timeout= @@global.rpl_semi_sync_master_timeout;
set @save_master_enabled= @@global.rpl_semi_sync_master_enabled;
set @save_master_wait_no_slave= @@global.rpl_semi_sync_master_wait_no_slave;
set global rpl_semi_sync_master_timeout= 10000;
set global rpl_semi_sync_master_enabled= 1;
show variables like 'rpl_semi_sync_master_enabled';
Variable_name	Value
rpl_semi_sync_master_enabled	ON
connection slave;
set @save_slave_enabled= @@global.rpl_semi_sync_slave_enabled;
include/stop_slave.inc
set global rpl_semi_sync_slave_enabled= 1;
include/start_slave.inc
connection master;
# Semi-sync should be active
show status like 'Rpl_semi_sync_master_status';
Variable_name	Value
Rpl_semi_sync_master_status	ON
show status like 'Rpl_semi_sync_master_clients';
Variable_name	Value
Rpl_semi_sync_master_clients	1
#
# Test 1: DML transactions (group commit path)
#
CREATE TABLE t1 (a INT PRIMARY KEY, b VARCHAR(100)) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1, 'first');
INSERT INTO t1 VALUES (2, 'second');
INSERT INTO t1 VALUES (3, 'third');
include/save_master_gtid.inc
connection slave;
include/sync_with_master_gtid.inc
connection master;
# All transactions should be semi-sync acknowledged
Rpl_semi_sync_master_yes_tx: 4 (should be >= 4)
show status like 'Rpl_semi_sync_master_no_tx';
Variable_name	Value
Rpl_semi_sync_master_no_tx	0
#
# Test 2: DDL statements (non-group-commit direct path)
#
CREATE TABLE t2 (a INT) ENGINE=InnoDB;
DROP TABLE t2;
include/save_master_gtid.inc
connection slave;
include/sync_with_master_gtid.inc
connection master;
DDL semi-sync acks: 2 (should be >= 2)
#
# Test 3: Multiple transactions under load
#
include/save_master_gtid.inc
connection slave;
include/sync_with_master_gtid.inc
connection master;
Load test semi-sync acks: 20 (should be >= 20)
show status like 'Rpl_semi_sync_master_no_tx';
Variable_name	Value
Rpl_semi_sync_master_no_tx	0
#
# Test 4: Verify semi-sync still works after slave reconnects
#
connection slave;
include/stop_slave.inc
include/start_slave.inc
connection master;
INSERT INTO t1 VALUES (200, 'after_reconnect');
include/save_master_gtid.inc
connection slave;
include/sync_with_master_gtid.inc
connection master;
# Semi-sync should still be ON after reconnect
show status like 'Rpl_semi_sync_master_status';
Variable_name	Value
Rpl_semi_sync_master_status	ON
#
# Test 5: Verify data on slave is correct
#
connection slave;
SELECT COUNT(*) FROM t1;
COUNT(*)
24
#
# Cleanup
#
connection master;
DROP TABLE t1;
include/save_master_gtid.inc
connection slave;
include/sync_with_master_gtid.inc
connection slave;
include/stop_slave.inc
set global rpl_semi_sync_slave_enabled= @save_slave_enabled;
include/start_slave.inc
connection master;
set global rpl_semi_sync_master_enabled= @save_master_enabled;
set global rpl_semi_sync_master_timeout= @save_master_timeout;
set global rpl_semi_sync_master_wait_no_slave= @save_master_wait_no_slave;
include/rpl_end.inc
