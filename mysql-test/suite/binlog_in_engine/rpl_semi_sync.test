#
# Test semi-synchronous replication with --binlog-storage-engine=innodb.
# This verifies that semi-sync works correctly using GTID-based transaction
# identification when the binlog is stored inside InnoDB.
#

--source include/have_binlog_format_mixed.inc
--source include/master-slave.inc
--source include/have_innodb_binlog.inc

# Suppress expected warnings
--connection master
call mtr.add_suppression("Timeout waiting for reply of binlog");
call mtr.add_suppression("Read semi-sync reply");
call mtr.add_suppression("mysqld: Got an error reading communication packets");
call mtr.add_suppression("Semi-sync master failed on net_flush");

--connection slave
set sql_log_bin=0;
call mtr.add_suppression("Semi-sync slave .* reply");
set sql_log_bin=1;

--connection master

--echo #
--echo # Setup semi-sync on master and slave
--echo #

set @save_master_timeout= @@global.rpl_semi_sync_master_timeout;
set @save_master_enabled= @@global.rpl_semi_sync_master_enabled;
set @save_master_wait_no_slave= @@global.rpl_semi_sync_master_wait_no_slave;

set global rpl_semi_sync_master_timeout= 10000;
set global rpl_semi_sync_master_enabled= 1;
show variables like 'rpl_semi_sync_master_enabled';

--connection slave
set @save_slave_enabled= @@global.rpl_semi_sync_slave_enabled;
--source include/stop_slave.inc
set global rpl_semi_sync_slave_enabled= 1;
--source include/start_slave.inc

--connection master
# Wait for slave to register as semi-sync
let $status_var= Rpl_semi_sync_master_clients;
let $status_var_value= 1;
--source include/wait_for_status_var.inc

--echo # Semi-sync should be active
show status like 'Rpl_semi_sync_master_status';
show status like 'Rpl_semi_sync_master_clients';

--echo #
--echo # Test 1: DML transactions (group commit path)
--echo #

CREATE TABLE t1 (a INT PRIMARY KEY, b VARCHAR(100)) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1, 'first');
INSERT INTO t1 VALUES (2, 'second');
INSERT INTO t1 VALUES (3, 'third');

--source include/save_master_gtid.inc
--connection slave
--source include/sync_with_master_gtid.inc

--connection master
--echo # All transactions should be semi-sync acknowledged
let $yes_tx= query_get_value(SHOW STATUS LIKE 'Rpl_semi_sync_master_yes_tx', Value, 1);
--echo Rpl_semi_sync_master_yes_tx: $yes_tx (should be >= 4)
show status like 'Rpl_semi_sync_master_no_tx';

--echo #
--echo # Test 2: DDL statements (non-group-commit direct path)
--echo #

let $yes_before= query_get_value(SHOW STATUS LIKE 'Rpl_semi_sync_master_yes_tx', Value, 1);

CREATE TABLE t2 (a INT) ENGINE=InnoDB;
DROP TABLE t2;

--source include/save_master_gtid.inc
--connection slave
--source include/sync_with_master_gtid.inc

--connection master
let $yes_after= query_get_value(SHOW STATUS LIKE 'Rpl_semi_sync_master_yes_tx', Value, 1);
let $yes_diff= `SELECT $yes_after - $yes_before`;
--echo DDL semi-sync acks: $yes_diff (should be >= 2)

--echo #
--echo # Test 3: Multiple transactions under load
--echo #

let $yes_before= query_get_value(SHOW STATUS LIKE 'Rpl_semi_sync_master_yes_tx', Value, 1);

--disable_query_log
let $i= 0;
while ($i < 20)
{
  eval INSERT INTO t1 VALUES (100 + $i, REPEAT('x', 50));
  inc $i;
}
--enable_query_log

--source include/save_master_gtid.inc
--connection slave
--source include/sync_with_master_gtid.inc

--connection master
let $yes_after= query_get_value(SHOW STATUS LIKE 'Rpl_semi_sync_master_yes_tx', Value, 1);
let $yes_diff= `SELECT $yes_after - $yes_before`;
--echo Load test semi-sync acks: $yes_diff (should be >= 20)
show status like 'Rpl_semi_sync_master_no_tx';

--echo #
--echo # Test 4: Verify semi-sync still works after slave reconnects
--echo #

--connection slave
--source include/stop_slave.inc
--source include/start_slave.inc

--connection master
# Wait for slave to re-register
let $status_var= Rpl_semi_sync_master_clients;
let $status_var_value= 1;
--source include/wait_for_status_var.inc

INSERT INTO t1 VALUES (200, 'after_reconnect');
--source include/save_master_gtid.inc
--connection slave
--source include/sync_with_master_gtid.inc

--connection master
--echo # Semi-sync should still be ON after reconnect
show status like 'Rpl_semi_sync_master_status';

--echo #
--echo # Test 5: Verify data on slave is correct
--echo #

--connection slave
SELECT COUNT(*) FROM t1;

--echo #
--echo # Cleanup
--echo #

--connection master
DROP TABLE t1;
--source include/save_master_gtid.inc
--connection slave
--source include/sync_with_master_gtid.inc

--connection slave
--source include/stop_slave.inc
set global rpl_semi_sync_slave_enabled= @save_slave_enabled;
--source include/start_slave.inc

--connection master
set global rpl_semi_sync_master_enabled= @save_master_enabled;
set global rpl_semi_sync_master_timeout= @save_master_timeout;
set global rpl_semi_sync_master_wait_no_slave= @save_master_wait_no_slave;

--source include/rpl_end.inc
